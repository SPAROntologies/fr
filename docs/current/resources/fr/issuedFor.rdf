<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#"
>
  <rdf:Description rdf:about="http://purl.org/spar/fr/issuedFor">
    <rdfs:comment xml:lang="en">The realation between a review and the entity (e.g. conference, journal) that it was issued for (usually the one that requested the review).</rdfs:comment>
    <vann:example>
	:my-review a fabio:Review ;
		frbr:realization :my-review-version ;
		fr:issuedFor :my-convening-organization .

	:my-convening-organization a fr:ConveningOrganization .
    </vann:example>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <rdfs:label xml:lang="en">issued for</rdfs:label>
    <rdfs:range rdf:resource="http://purl.org/spar/fr/ConveningOrganization"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://purl.org/spar/fabio/Review"/>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/fr/"/>
  </rdf:Description>
</rdf:RDF>
