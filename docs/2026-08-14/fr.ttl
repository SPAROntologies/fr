@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix bido: <http://purl.org/spar/bido/> .
@prefix c4o: <http://purl.org/spar/c4o/> .
@prefix cito: <http://purl.org/spar/cito/> .
@prefix datacite: <http://purl.org/spar/datacite/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fabio: <http://purl.org/spar/fabio/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix fr: <http://purl.org/spar/fr/> .
@prefix frbr: <http://purl.org/vocab/frbr/core#> .
@prefix literal: <http://www.essepuntato.it/2010/06/literalreification/> .
@prefix lvont: <http://lexvo.org/ontology#> .
@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix reg: <http://purl.org/linked-data/registry#> .
@prefix schema: <https://schema.org/> .
@prefix skos1: <http://www.w3.org/2008/05/skos#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix vs: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

lvont:Language a owl:Class ;
    rdfs:label "language"@en ;
    rdfs:comment "Groups of human language variants that are or were spoken, written, or signed at some point in time."@en ;
    rdfs:isDefinedBy lvont: .

dc:creator a owl:AnnotationProperty .

dc:date a owl:AnnotationProperty .

dc:language a owl:AnnotationProperty .

dc:rights a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:label "has creator" ;
    rdfs:comment "An entity responsible for making the resource."@en ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:range foaf:Agent .

dcterms:issued a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:label "has date issued"@en ;
    rdfs:comment "Date of formal issuance of the resource."@en ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:range rdfs:Literal .

dcterms:language a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:label "has language"@en ;
    rdfs:comment "A language of the resource."@en ;
    rdfs:isDefinedBy dcterms: .

dcterms:license a owl:AnnotationProperty,
        owl:Class ;
    rdfs:label "has license"@en ;
    rdfs:comment "A legal document giving official permission to do something with the resource."@en ;
    rdfs:isDefinedBy dcterms: .

dcterms:modified a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:label "has date modified"@en ;
    rdfs:comment "Date on which the resource was changed."@en ;
    rdfs:isDefinedBy dcterms: ;
    rdfs:range rdfs:Literal .

bido:DiscreteReviewRatingScale a owl:Class ;
    rdfs:label "discrete review rating scale"@en ;
    rdfs:comment "A discrete scale defining the rating given by a reviewer for a specific scientific contribution."@en ;
    rdfs:isDefinedBy bido: ;
    rdfs:subClassOf bido:ReviewRatingScale .

bido:DiscreteReviewerConfidenceScale a owl:Class ;
    rdfs:label "discrete reviewer confidence scale"@en ;
    rdfs:comment "A discrete scale defining the confidence of a reviewer for a given topic."@en ;
    rdfs:isDefinedBy bido: ;
    rdfs:subClassOf bido:ReviewerConfidenceScale .

bido:hasConfidenceValue a owl:DatatypeProperty ;
    rdfs:label "has confidence value"@en ;
    rdfs:comment "The confidence value of expertise in the review topic given by the reviewer."@en ;
    rdfs:domain bido:ReviewerConfidenceValue ;
    rdfs:isDefinedBy bido: ;
    rdfs:range rdfs:Literal .

bido:hasRatingValue a owl:DatatypeProperty ;
    rdfs:label "has rating value"@en ;
    rdfs:comment "The value of the rating given to a review."@en ;
    rdfs:domain bido:ReviewRatingValue ;
    rdfs:isDefinedBy bido: ;
    rdfs:range rdfs:Literal .

bido:isDefinedIn a owl:ObjectProperty ;
    rdfs:label "is defined in ranking"@en ;
    rdfs:comment "A relation between a ranking category and the ranking that defines it."@en ;
    rdfs:domain bido:CategorialBibliometricData ;
    rdfs:isDefinedBy bido: ;
    rdfs:range skos1:ConceptScheme .

c4o:hasContent a owl:DatatypeProperty ;
    rdfs:label "has content"@en ;
    rdfs:comment "The textual content of a particular FRBR expression."@en ;
    rdfs:domain frbr:Expression ;
    rdfs:isDefinedBy c4o: ;
    rdfs:range rdfs:Literal .

cito:repliesTo a owl:ObjectProperty ;
    rdfs:label "replies to"@en ;
    rdfs:comment "A relation according to which the citing entity replies to statements, ideas or criticisms presented in the cited entity."@en ;
    rdfs:isDefinedBy cito: .

cito:reviews a owl:ObjectProperty ;
    rdfs:label "reviews"@en ;
    rdfs:comment "A relation according to which the citing entity reviews statements, ideas or conclusions presented in the cited entity."@en ;
    rdfs:isDefinedBy cito: .

fabio:hasURL a owl:DatatypeProperty ;
    rdfs:label "has URL"@en ;
    rdfs:comment "An identifier, in form of an HTTP Universal Resource Locator (URL), for a particular resource on the World Wide Web."@en ;
    rdfs:domain frbr:Endeavour ;
    rdfs:isDefinedBy fabio: ;
    rdfs:range xsd:anyURI .

<http://purl.org/spar/fr> a owl:Ontology ;
    rdfs:label "FAIR Reviews Ontology (FR)"@en ;
    dc:contributor "Sebastian Barzaghi (https://orcid.org/0000-0002-0799-1527)"^^xsd:string,
        "Silvio Peroni (https://orcid.org/0000-0003-0530-4305)"^^xsd:string ;
    dc:creator "Idafen Santana Pérez (https://orcid.org/0000-0001-8296-8629)"^^xsd:string,
        "María Poveda Villalón (https://orcid.org/0000-0003-3587-0367)"^^xsd:string ;
    dc:date "2026-08-14" ;
    dc:description """
The **_FAIR Reviews Ontology (FR)_** defines a set of classes, properties and axioms, for describing research reviews as semantic objects, reusing standard existing vocabularies using ontology engineering techniques. 
Besides defining its own classes and properties, FR reuses many ontological elements drawn from existing ontologies such as [FaBiO](http://purl.org/spar/fabio/), [BiDO](http://purl.org/spar/bido), [DataCite](http://purl.org/spar/datacite/) from the SPAR Ontologies, and others like [ODRL](https://www.w3.org/community/odrl/), [FOAF](http://xmlns.com/foaf/0.1/), [SKOS](http://www.w3.org/2004/02/skos/core#) or the [Lexvo Ontology](http://lexvo.org/ontology). 

![The architecture of FR.](fr.png)

It is used to annotate http://fairreviews.linkeddata.es/ data.

## Examples of use

In the following subsections, we introduce some examples to showcase how to use FR. 

The prefixes that are used in all the examples provided below are defined as follows:

	@prefix fr: <http://purl.org/spar/fr/> .
	@prefix bido: <http://purl.org/spar/bido/> .
	@prefix cito: <http://purl.org/spar/cito/> .
	@prefix fr: <http://purl.org/spar/fr/> .
	@prefix fabio: <http://purl.org/spar/fabio/> .
	@prefix c4o: <http://purl.org/spar/c4o/> .
	@prefix datacite: <http://purl.org/spar/datacite/> .
	@prefix literal: <http://www.essepuntato.it/2010/06/literalreification/> .
	@prefix dcterms: <http://purl.org/dc/terms/> .

### Describing a workshop review

FR can be used to describe any kind of research review, such as a workshop review. 
More precisely, the example represents the instantiation of the model for an existing review issued for the _SemSci2017_ workshop. 
The original review is [available as plain text online](https://semsci.github.io/semSci2017/openReview/Paper2Reviews.txt).

	<https://w3id.org/fr/resource/paper/1> a fabio:ConferencePaper ;
		fabio:hasURL "http://ceur-ws.org/Vol-1931/paper-01.pdf"^^xsd:anyURI .

	<https://w3id.org/fr/resource/pid/1> a datacite:PersonalIdentifier ;
		datacite:usesIdentifierScheme datacite:orcid ;
		literal:hasLiteralValue "0000-0001-8296-8629" .

	<https://w3id.org/fr/resource/review/1> a fabio:Review ;
		frbr:realization <https://w3id.org/fr/resource/rev/1> .

	<https://w3id.org/fr/resource/rev/1> a fr:ReviewVersion ;
		frbr:creator <http://w3id.org/people/idafensp> ;
		dcterms:language <http://www.lexvo.org/page/iso639-3/eng> ;
		dcterms:license <https://creativecommons.org/licenses/by-sa/4.0> ;
		fr:hasRating bido:sa-sr-bl-wacc ;
		fr:hasReviewerConfidence bido:acl-1-5-acl4 ;
		cito:reviews <https://w3id.org/fr/resource/paper/1> ;
		fr:issuedAt <https://easychair.org> ;
		fr:issuedFor <https://semsci.github.io/semSci2017> ;
		fr:releasedBy <https://semsci.github.io/semSci2017> ;
		dcterms:issued "2017-08-22"^^xsd:date ;
		c4o:hasContent \"\"\"The paper introduces SMS, a platform for for data integration
						in the context of STI. The paper is general well written, proposing
						an interesting contribution as well as sufficient evidences, in the
						form of pointers to online resources, to support its claims.

						It is not clear though which is the research question being targeted
						in this paper. The paper elaborates on the features of the SMS platform,
						including its models and its applications, but lacks to provide insights
						on the novelty of the approach and how it compares to others.

						Also, authors could consider adding some narrative to section 3, or
						even better, try to include those use cases as part of the descriptions
						of the SMS platform along section 2.

						As a minor comment, the abstract and the first paragraph of section 1
						are almost identical. Authors should consider removing or rephrasing
						them.\"\"\"^^rdfs:Literal .

## Competency Questions

FR can be used for answering several questions related to research reviews characteristics. 
In the following subsections, some of them are introduced together with their respective SPARQL queries. 

The prefixes that are used in all the SPARQL queries provided below are defined as follows:

	PREFIX fr: <http://purl.org/spar/fr/>
	PREFIX c4o: <http://purl.org/spar/c4o/>
	PREFIX cito: <http://purl.org/spar/cito/>
	PREFIX dcterms: <http://purl.org/dc/terms/>
	PREFIX fabio: <http://purl.org/spar/fabio/>
	PREFIX frbr: <http://purl.org/vocab/frbr/core#>

### CQ1

Which document is reviewed by a specific review version, and who is its creator?

	SELECT ?reviewVersion ?paper ?creator
	WHERE {
		?reviewVersion a fr:ReviewVersion ;
			cito:reviews ?paper .
		OPTIONAL { ?reviewVersion frbr:creator ?creator . }
	}

### CQ2

What rating and reviewer confidence score are assigned to a review version?

	SELECT ?reviewVersion ?rating ?confidence
	WHERE {
		?reviewVersion a fr:ReviewVersion ;
			fr:hasRating ?rating .
		OPTIONAL { ?reviewVersion fr:hasReviewerConfidence ?confidence . }
	}

### CQ3

At which platform was a review version issued, and for which venue or event was it issued?

	SELECT ?reviewVersion ?platform ?venue
	WHERE {
		?reviewVersion a fr:ReviewVersion ;
			fr:issuedAt ?platform .
		OPTIONAL { ?reviewVersion fr:issuedFor ?venue . }
	}

### CQ4

Which agent or entity released a review version, and on what date was it issued?

	SELECT ?reviewVersion ?releasingEntity ?issueDate
	WHERE {
		?reviewVersion a fr:ReviewVersion ;
			fr:releasedBy ?releasingEntity .
		OPTIONAL { ?reviewVersion dcterms:issued ?issueDate . }
	}

### CQ5

What is the full review version of a review, including its textual content and license?

	SELECT ?review ?reviewVersion ?content ?license
	WHERE {
		?review a fabio:Review ;
			frbr:realization ?reviewVersion .
		?reviewVersion a fr:ReviewVersion .
		OPTIONAL { ?reviewVersion c4o:hasContent ?content . }
		OPTIONAL { ?reviewVersion dcterms:license ?license . }
	}
"""@en ;
    dc:title "The FAIR Reviews Ontology (FR)"@en ;
    dcterms:bibliographicCitation "Idafen Santana Pérez, María Poveda Villalón. The FAIR Review Ontology. Revision: 2.0.0. http://purl.org/spar/fr." ;
    dcterms:created "2017-09-01" ;
    dcterms:issued "2017-11-07" ;
    dcterms:license <http://purl.org/NET/rdflicense/cc-by4.0> ;
    dcterms:modified "2026-08-14" ;
    dcterms:publisher <http://www.oeg-upm.net/> ;
    dcterms:source <https://github.com/SPAROntologies/fr/blob/master/docs/cq.md> ;
    bibo:doi "https://doi.org/10.25504/FAIRsharing.e7e609" ;
    bibo:status <http://purl.org/ontology/bibo/status/published> ;
    vann:changes """
* **v2.0.0**: 
Added new documentation, including annotation properties (e.g., `bibo:doi`, `schema:codeRepository`, etc.), term properties (e.g., `vann:example`, `vs:term_status`, etc.), exemplary competency questions with their respective SPARQL queries, and a Grafoo diagram.
Added the additional classes and properties from external ontologies.
Replaced `fr:ratingValue` with `bido:hasRatingValue`, given they were identical in their implementation and the latter already existed.
Replaced `skos:inScheme` with `bido:isDefinedIn`, given it is its subproperty that is appliable to categorical bibliometric data, such as in this case.
	"""@en ;
    vann:preferredNamespacePrefix "fr" ;
    vann:preferredNamespaceUri "http://purl.org/spar/fr" ;
    rdfs:seeAlso <http://www.sparontologies.net/ontologies/fr> ;
    owl:backwardCompatibleWith fr:2017-09-01 ;
    owl:imports <http://purl.org/spar/datacite> ;
    owl:priorVersion fr:2017-09-01 ;
    owl:versionIRI fr:2026-08-14 ;
    owl:versionInfo "2.0.0" ;
    foaf:logo <https://github.com/SPAROntologies/fr/blob/master/spar.png> ;
    schema:codeRepository <https://github.com/SPAROntologies/fr> ;
    schema:image <https://github.com/SPAROntologies/fr/blob/master/docs/current/fr.png> ;
    schema:includedInDataCatalog <https://fairsharing.org/> ;
    schema:keywords "bibliometrics"@en,
        "scholarly publishing"@en,
        "scholarly reviews"@en,
        "scientometrics"@en,
        "semantic publishing"@en .

fr:hasRating a owl:ObjectProperty ;
    rdfs:label "has rating"@en ;
    vann:example """
	:my-review-version a fr:ReviewVersion ;
		fr:hasRating bido:sa-sr-bl-wacc .

	bido:sa-sr-bl-wacc a bido:ReviewRatingValue .
    """ ;
    rdfs:comment "The relation between a review and a given rating assigned by a reviewer."@en ;
    rdfs:domain fr:ReviewVersion ;
    rdfs:isDefinedBy fr: ;
    rdfs:range bido:ReviewRatingValue ;
    vs:term_status reg:statusStable .

fr:hasReviewerConfidence a owl:ObjectProperty ;
    rdfs:label "has reviewer confidence"@en ;
    vann:example """
	:my-review-version a fr:ReviewVersion ;
		fr:hasReviewerConfidence bido:acl-1-5-acl4 .

	bido:acl-1-5-acl4 a bido:ReviewerConfidenceValue .
    """ ;
    rdfs:comment "Relation between a review and the confidence set by the author about the review topic. As the review can be written only by one author, the confidence is assumed to be for such author about the given paper without need of creating a new class involving the three actors in a n-ary alike solution." ;
    rdfs:domain fr:ReviewVersion ;
    rdfs:isDefinedBy fr: ;
    rdfs:range bido:ReviewerConfidenceValue ;
    vs:term_status reg:statusStable .

fr:hasSubReviewer a owl:ObjectProperty ;
    rdfs:label "has sub-reviewer"@en ;
    vann:example """
	:my-review-version a fr:ReviewVersion ;
		fr:hasSubReviewer :my-person .
	
	:my-person a foaf:Agent .
    """ ;
    rdfs:comment "The relation between a review and agents that have contributed to the overall review as sub-reviwers."@en ;
    rdfs:domain fr:ReviewVersion ;
    rdfs:isDefinedBy fr: ;
    rdfs:range foaf:Agent ;
    vs:term_status reg:statusStable .

fr:issuedAt a owl:ObjectProperty ;
    rdfs:label "issued at"@en ;
    vann:example """
	:my-review a fabio:Review ;
		frbr:realization :my-review-version ;
		fr:issuedAt :my-tracking-system .

	:my-tracking-system a fr:TrackingSystem .
    """ ;
    rdfs:comment "The relation between a review and the tracking or scholarly venue management system where the reviewing process took place."@en ;
    rdfs:domain fabio:Review ;
    rdfs:isDefinedBy fr: ;
    rdfs:range fr:TrackingSystem ;
    vs:term_status reg:statusStable .

fr:issuedFor a owl:ObjectProperty ;
    rdfs:label "issued for"@en ;
    vann:example """
	:my-review a fabio:Review ;
		frbr:realization :my-review-version ;
		fr:issuedFor :my-convening-organization .

	:my-convening-organization a fr:ConveningOrganization .
    """ ;
    rdfs:comment "The realation between a review and the entity (e.g. conference, journal) that it was issued for (usually the one that requested the review)."@en ;
    rdfs:domain fabio:Review ;
    rdfs:isDefinedBy fr: ;
    rdfs:range fr:ConveningOrganization ;
    vs:term_status reg:statusStable .

fr:releasedBy a owl:ObjectProperty ;
    rdfs:label "released by"@en ;
    vann:example """
	:my-review-version a fr:ReviewVersion ;
		fr:releasedBy :my-conference .

	:my-conference a foaf:Agent .
    """ ;
    rdfs:comment "The relation between a review and the agent publishing it. It might be the author of the review or conference or journal to which the scientific resource was submitted to."@en ;
    rdfs:domain fr:ReviewVersion ;
    rdfs:isDefinedBy fr: ;
    rdfs:range foaf:Agent ;
    vs:term_status reg:statusStable .

frbr:realization a owl:ObjectProperty ;
    rdfs:label "has realization"@en ;
    rdfs:comment "The expression that is a realization of a work."@en ;
    rdfs:domain frbr:Work ;
    rdfs:isDefinedBy frbr: ;
    rdfs:range frbr:Expression .

literal:hasLiteralValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "has literal value"@en ;
    rdfs:comment "The value that a reified literal represents."@en ;
    rdfs:domain literal:Literal ;
    rdfs:isDefinedBy <http://purl.org/spar/literal/> ;
    rdfs:range rdfs:Literal .

odrl:Policy a owl:Class ;
    rdfs:label "policy"@en ;
    rdfs:comment "A non-empty group of permissions and/or prohibitions."@en ;
    rdfs:isDefinedBy odrl: .

bido:ReviewRatingScale a owl:Class ;
    rdfs:label "review rating scale"@en ;
    rdfs:comment "A scale defining the rating given by a reviewer for a specific scientific contribution."@en ;
    rdfs:isDefinedBy bido: ;
    rdfs:subClassOf skos1:ConceptScheme .

bido:ReviewerConfidenceScale a owl:Class ;
    rdfs:label "reviewer confidence scale"@en ;
    rdfs:comment "A scale defining the confidence of a reviewer for a given topic."@en ;
    rdfs:isDefinedBy bido: ;
    rdfs:subClassOf skos1:ConceptScheme .

bido:ScholarlyVenueManagementSystem a owl:Class ;
    rdfs:label "scholarly venue management system"@en ;
    rdfs:comment "A venue management system (such as a conference management system or a journal management system) that can be used for managing scholarly venues."@en ;
    rdfs:isDefinedBy bido: .

datacite:AgentIdentifierScheme a owl:Class ;
    rdfs:label "agent identifier scheme"@en ;
    rdfs:comment "The identifier scheme used to identify an agent."@en ;
    rdfs:isDefinedBy datacite: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf datacite:usesIdentifierScheme ] ;
            owl:someValuesFrom datacite:AgentIdentifier ],
        datacite:IdentifierScheme .

datacite:PersonalIdentifier a owl:Class ;
    rdfs:label "personal identifier"@en ;
    rdfs:comment "An identifier that uniquely identifies an individual person."@en ;
    rdfs:isDefinedBy datacite: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom datacite:PersonalIdentifierScheme ;
            owl:onProperty datacite:usesIdentifierScheme ],
        datacite:AgentIdentifier .

datacite:PersonalIdentifierScheme a owl:Class ;
    rdfs:label "personal identifier scheme"@en ;
    rdfs:comment "The identifier scheme used to identify a person."@en ;
    rdfs:isDefinedBy datacite: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf datacite:usesIdentifierScheme ] ;
            owl:someValuesFrom datacite:PersonalIdentifier ],
        datacite:AgentIdentifierScheme .

datacite:ResourceIdentifierScheme a owl:Class ;
    rdfs:label "resource identifier scheme"@en ;
    rdfs:comment "The identifier scheme used to identify a resource."@en ;
    rdfs:isDefinedBy datacite: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf datacite:usesIdentifierScheme ] ;
            owl:someValuesFrom datacite:ResourceIdentifier ],
        datacite:IdentifierScheme .

datacite:hasIdentifier a owl:InverseFunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has identifier"@en ;
    rdfs:comment "A unique identifier for the entity (either a funder, a person, a license or a resource)."@en ;
    rdfs:isDefinedBy datacite: ;
    rdfs:range datacite:Identifier .

fabio:Comment a owl:Class ;
    rdfs:label "comment"@en ;
    rdfs:comment "A verbal or written remark concerning some entity. In written form, a comment is often appended to that entity and termed an annotation. Within computer programs or ontologies, comments are added to enhance human understanding, and are usually prefaced by a special syntactic symbol that ensures they are ignored during execution of the program."@en ;
    rdfs:isDefinedBy fabio: ;
    rdfs:subClassOf fabio:Expression .

fabio:Expression a owl:Class ;
    rdfs:label "expression"@en ;
    rdfs:comment "A subclass of FRBR Expression, restricted to expressions of `fabio:Work`."@en ;
    rdfs:isDefinedBy fabio: ;
    rdfs:subClassOf frbr:Expression .

fabio:Work a owl:Class ;
    rdfs:label "work"@en ;
    rdfs:comment "A subclass of FRBR Work, restricted to works that are published or potentially publishable, and that contain or are referred to by bibliographic references, or entities used to define bibliographic references."@en ;
    rdfs:isDefinedBy fabio: ;
    rdfs:subClassOf frbr:Work .

fr:ConveningOrganization a owl:Class ;
    rdfs:label "convening organization"@en ;
    vann:example """
	:my-review a fabio:Review ;
		frbr:realization :my-review-version ;
		fr:issuedFor :my-convening-organization .

	:my-convening-organization a fr:ConveningOrganization .
    """ ;
    rdfs:comment "A venue (e.g. conference, workshop), a expression collection (e.g. journal, special issue), or an individual agent (e.g. organization, researcher) collecting scientific contributions."@en ;
    rdfs:isDefinedBy fr: ;
    rdfs:subClassOf foaf:Agent ;
    vs:term_status reg:statusStable .

fr:TrackingSystem a owl:Class ;
    rdfs:label "tracking system"@en ;
    vann:example """
	:my-review a fabio:Review ;
		frbr:realization :my-review-version ;
		fr:issuedAt :my-tracking-system .

	:my-tracking-system a fr:TrackingSystem .
    """ ;
    rdfs:comment "The platform where the review process takes place."@en ;
    rdfs:isDefinedBy fr: ;
    rdfs:subClassOf bido:ScholarlyVenueManagementSystem ;
    vs:term_status reg:statusStable .

frbr:Endeavour a owl:Class ;
    rdfs:label "endeavour"@en ;
    rdfs:comment "The set of different aspects of user interests in the products of intellectual or artistic artifact."@en ;
    rdfs:isDefinedBy frbr: .

bido:CategorialBibliometricData a owl:Class ;
    rdfs:label "categorial bibliometric data"@en ;
    rdfs:comment "Categorical information that characterises publication-related entities from a bibliometric point of view."@en ;
    rdfs:isDefinedBy bido: .

bido:ReviewRatingValue a owl:Class ;
    rdfs:label "review rating concept"@en ;
    rdfs:comment "The set of values of a given rating scale."@en ;
    rdfs:isDefinedBy bido: ;
    rdfs:subClassOf bido:CategorialBibliometricData .

bido:ReviewerConfidenceValue a owl:Class ;
    rdfs:label "reviewer confidence value"@en ;
    rdfs:comment "The set of values of a given confidence scale."@en ;
    rdfs:isDefinedBy bido: .

datacite:ResourceIdentifier a owl:Class ;
    rdfs:label "resource identifier"@en ;
    rdfs:comment "An identifier that is used to uniquely identify a resource."@en ;
    rdfs:isDefinedBy datacite: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom datacite:ResourceIdentifierScheme ;
            owl:onProperty datacite:usesIdentifierScheme ],
        datacite:Identifier .

fabio:Review a owl:Class ;
    rdfs:label "review"@en ;
    rdfs:comment "A review of others' work."@en ;
    rdfs:isDefinedBy fabio: ;
    rdfs:subClassOf fabio:Work .

frbr:Work a owl:Class ;
    rdfs:label "work"@en ;
    rdfs:comment """
A distinct intellectual or artistic creation.

A work is an abstract entity; there is no single material object one can point to as the work. We recognize the work through individual realizations or expressions of the work, but the work itself exists only in the commonality of content between and among the various expressions of the work. When we speak of Homer's Iliad as a work, our point of reference is not a particular recitation or text of the work, but the intellectual creation that lies behind all the various expressions of the work.
        """@en ;
    rdfs:isDefinedBy frbr: .

literal:Literal a owl:Class ;
    rdfs:label "literal"@en ;
    rdfs:comment "A reified literal."@en ;
    rdfs:isDefinedBy <http://purl.org/spar/literal/> .

datacite:AgentIdentifier a owl:Class ;
    rdfs:label "agent identifier"@en ;
    rdfs:comment "An identifier that uniquely identities an individual agent."@en ;
    rdfs:isDefinedBy datacite: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom datacite:AgentIdentifier ;
            owl:onProperty datacite:usesIdentifierScheme ],
        datacite:Identifier ;
    owl:disjointWith datacite:ResourceIdentifier .

frbr:Expression a owl:Class ;
    rdfs:label "expression"@en ;
    rdfs:comment """
The intellectual or artistic realization of a work in the form of alpha-numeric, musical, or choreographic notation, sound, image, object, movement, etc., or any combination of such forms.

An expression is the specific intellectual or artistic form that a work takes each time it is 'realized'. 
Expression encompasses, for example, the specific words, sentences, paragraphs, etc. that result from the realization of a work in the form of a text, or the particular sounds, phrasing, etc. resulting from the realization of a musical work.
        """@en ;
    rdfs:isDefinedBy frbr: .

skos1:ConceptScheme a owl:Class ;
    rdfs:label "concept scheme"@en ;
    rdfs:comment "A SKOS concept scheme can be viewed as an aggregation of one or more SKOS concepts."@en ;
    rdfs:isDefinedBy skos1: .

datacite:Identifier a owl:Class ;
    rdfs:label "identifier"@en ;
    rdfs:comment "An identifier that uniquely identities an entity, such as a funding agency, a person or a resource."@en ;
    rdfs:isDefinedBy datacite: ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass datacite:IdentifierScheme ;
            owl:onProperty datacite:usesIdentifierScheme ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty [ owl:inverseOf datacite:hasIdentifier ] ],
        literal:Literal .

datacite:IdentifierScheme a owl:Class ;
    rdfs:label "identifier scheme"@en ;
    rdfs:comment "The identifier scheme used to identify an entity such as a funding agency, a person or a resource."@en ;
    rdfs:isDefinedBy datacite: .

fr:ReviewVersion a owl:Class ;
    rdfs:label "review version"@en ;
    vann:example """
	:my-review a fabio:Review ;
		frbr:realization :my-review-version .

	:my-review-version a fr:ReviewVersion ;
		fr:hasRating bido:sa-sr-bl-wacc ;
		fr:hasReviewerConfidence bido:acl-1-5-acl4 ;
		fr:hasSubReviewer :my-person ;
		fr:releasedBy :my-conference .
    """ ;
    rdfs:comment "A version of a given review, defining its content and rating, which may vary over the time."@en ;
    rdfs:isDefinedBy fr: ;
    rdfs:subClassOf fabio:Comment ;
    vs:term_status reg:statusStable .

foaf:Agent a owl:Class ;
    rdfs:label "agent"@en ;
    rdfs:comment "An agent (eg. person, group, software or physical artifact)."@en ;
    rdfs:isDefinedBy foaf: .

datacite:usesIdentifierScheme a owl:ObjectProperty ;
    rdfs:label "uses identifier scheme"@en ;
    rdfs:comment "The identifier scheme used to provide the identifier for an entity (either a funder, a person, a license or a resource)."@en ;
    rdfs:domain datacite:Identifier ;
    rdfs:isDefinedBy datacite: ;
    rdfs:range datacite:IdentifierScheme .

